  "fixed_sql": [
    {
      "name": "agent_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"agent_runs\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"repo\" TEXT NOT NULL, \"title\" TEXT NULL, \"state\" TEXT NOT NULL, \"worktree_path\" TEXT NULL, \"branch\" TEXT NULL, \"pr_number\" INTEGER NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"started_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, \"detail\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "agent_run_issues",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"agent_run_issues\" (\"run_id\" TEXT NOT NULL REFERENCES agent_runs (id) ON DELETE CASCADE, \"issue_key\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"run_id\", \"issue_key\"));"
        }
      ]
    },
    {
      "name": "agent_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"agent_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"run_id\" TEXT NOT NULL REFERENCES agent_runs (id) ON DELETE CASCADE, \"at\" TEXT NOT NULL, \"stage\" TEXT NULL, \"level\" TEXT NOT NULL, \"message\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "worktree_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"worktree_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"repo_path\" TEXT NOT NULL, \"repo_name\" TEXT NOT NULL, \"worktree_path\" TEXT NOT NULL, \"worktree_name\" TEXT NOT NULL, \"branch\" TEXT NULL, \"jira_issue\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "manual_posts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"manual_posts\" (\"id\" TEXT NOT NULL, \"at\" TEXT NOT NULL, \"repo_name\" TEXT NOT NULL, \"issue_key\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"hours\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "issue_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"issue_cache\" (\"source\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"source\", \"key\"));"
        }
      ]
    },
    {
      "name": "claude_transcripts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"claude_transcripts\" (\"path\" TEXT NOT NULL, \"project_dir\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"mtime\" INTEGER NOT NULL, \"scanned_bytes\" INTEGER NOT NULL, \"active_days\" TEXT NOT NULL, PRIMARY KEY (\"path\"));"
        }
      ]
    },
    {
      "name": "worktree_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"worktree_metadata\" (\"path\" TEXT NOT NULL, \"repo_path\" TEXT NOT NULL, \"base_branch\" TEXT NULL, \"jira_issue\" TEXT NULL, \"github_issue\" INTEGER NULL, \"pr_author\" TEXT NULL, \"kickoff_prompt_path\" TEXT NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"snoozed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"snoozed\" IN (0, 1)), \"has_session\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_session\" IN (0, 1)), \"session_prompt\" TEXT NULL, \"session_started_at\" TEXT NULL, PRIMARY KEY (\"path\"));"
        }
      ]
    },
    {
      "name": "jira_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"jira_tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
